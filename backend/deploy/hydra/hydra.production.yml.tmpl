serve:
  public:
    base_url: https://{{HYDRA_HOSTNAME}}/
    tls:
      allow_termination_from:
        - 0.0.0.0/0
  admin:
    base_url: http://hydra:4445/

oauth2:
  expose_internal_errors: false
  pkce:
    enforced: true
    enforced_for_public_clients: true

urls:
  self:
    issuer: https://{{HYDRA_HOSTNAME}}/
  consent: {{APP_BASE_URL}}/v1/auth/consent
  login: {{APP_BASE_URL}}/v1/auth/login
  logout: {{APP_BASE_URL}}/v1/auth/logout
  post_logout_redirect: {{APP_BASE_URL}}/login

ttl:
  access_token: 5m
  refresh_token: 720h
  id_token: 5m
  auth_code: 10m

strategies:
  access_token: jwt

log:
  level: {{ORY_LOG_LEVEL}}
  format: text
  leak_sensitive_values: false
